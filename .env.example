APP_NAME="Gimnasio Castillo Americano"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/colegio_webv3

# Neon (PostgreSQL) — cadena de conexión completa (recomendado)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Alternativa: variables sueltas. Neon exige TLS (sslmode=require).
#DB_HOST=ep-xxxx-pooler.region.aws.neon.tech
#DB_PORT=5432
#DB_NAME=neondb
#DB_USER=usuario
#DB_PASS=clave
#DB_SSLMODE=require

SESSION_LIFETIME=7200

# Correo: API de Brevo (recomendado en Railway, que bloquea SMTP) o SMTP
BREVO_API_KEY=
MAIL_FROM_ADDRESS=correo-verificado-en-brevo@gmail.com
MAIL_FROM_NAME=Gimnasio Castillo Americano
MAIL_ADMIN=correo-que-recibe-el-formulario-de-contacto@gmail.com

# Redes sociales del colegio (URL completa). Vacío = el ícono no se muestra.
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
SOCIAL_TIKTOK=
