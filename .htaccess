# Proteger archivos sensibles
<FilesMatch "\.(env|sql|md|log|lock|phar|py|bak|docx|example)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(Dockerfile|railway\.json|vercel\.json|composer\.json|\.gitignore|\.dockerignore|\.htaccess)$">
    Require all denied
</FilesMatch>

# Proteger directorios internos
RedirectMatch 403 ^/src/.*$
RedirectMatch 403 ^/config/(?!database\.php$).*$
RedirectMatch 403 ^/tools/.*$
RedirectMatch 403 ^/database/.*$
# Los boletines NO se sirven como archivo estático: se piden por
# boletin_descargar.php, que valida quién los pide.
RedirectMatch 403 ^/assets/uploads/boletines/.*$
# Nunca se ejecuta código subido (el volumen de Railway se monta encima de
# assets/uploads, así que un .htaccess dentro de esa carpeta no serviría)
RedirectMatch 403 "(?i)^/assets/uploads/.*\.(php[0-9]?|phtml|phar|pht|cgi|pl|py|sh|html?|svg)$"
# Nada de lib/ se pide por web (son helpers y dompdf, se usan con require)
RedirectMatch 403 ^/lib/.*$
RedirectMatch 403 ^/assets/backup/.*$
RedirectMatch 403 ^/vendor/.*$

# Desactivar listado de directorios
Options -Indexes

# Seguridad de sesión. "secure" lo decide Session::start() según si la
# petición llegó por HTTPS (también detrás del proxy de Vercel).
<IfModule php_module>
    php_flag session.cookie_httponly on
    php_flag session.use_strict_mode on
    php_value session.cookie_samesite "Lax"
</IfModule>

# Cabeceras de seguridad
#  - frame-ancestors / X-Frame-Options: nadie puede meter el panel en un
#    iframe para engañar al admin (clickjacking sobre "Publicar todos").
#  - La CSP admite 'unsafe-inline' porque las páginas usan <script> y
#    style= en línea; aun así limita de dónde se cargan scripts, iframes
#    y a dónde se envían formularios.
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' https:; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com https://www.google.com; connect-src 'self' https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    Header always unset X-Powered-By
</IfModule>

# UTF-8
AddDefaultCharset UTF-8

# Cache de assets
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff2?)$">
    Header set Cache-Control "max-age=2592000, public"
</FilesMatch>
